//@version=6
indicator("MEXC Scalp – 3m/5m/15m v1.4", overlay=true, max_lines_count=12, max_boxes_count=4)

// سكالب سولانا: نطاق ضيق يتكرر ثم كنس أو كسر. رافعة عالية = لا دخول وسط الصندوق.
emaFastLen = input.int(5,  "EMA سريع", minval=3)
emaSlowLen = input.int(13, "EMA بطيء", minval=8)
rsiLen     = input.int(7,  "RSI")
volLen     = input.int(20, "Volume SMA")
showTable  = input.bool(true, "إظهار الجدول")
showBox    = input.bool(true, "رسم النطاق")

grpMx = "صفقة MEXC — انسخ Size(Cont)"
mxSide   = input.string("شراء", "الاتجاه", options=["شراء", "بيع"], group=grpMx)
mxEntry  = input.float(0.0, "سعر الدخول", group=grpMx)
mxCont   = input.int(0, "الكمية Cont", minval=0, group=grpMx)
mxLev    = input.float(115.0, "الرافعة", minval=1, maxval=200, step=1, group=grpMx)
mxMargin = input.float(0.0, "الهامش USDT", group=grpMx)
mxMMR    = input.float(0.4, "هامش الصيانة %", minval=0.1, step=0.1, group=grpMx)
mxContSz = input.float(0.1, "1 Cont = ؟ SOL", minval=0.0001, step=0.01, group=grpMx)

grpNews = "توقع الخبر"
newsBiasIn = input.string("تلقائي", "توقّع السوق", options=["تلقائي", "تيسير", "محايد", "تشديد"], group=grpNews)

// ══════════════════════════════════════════════════════════════
// التوقيت — حدث NY / عرض أمستردام
// ══════════════════════════════════════════════════════════════
tzAMS = "Europe/Amsterdam"
tzNY  = "America/New_York"

h = hour(timenow, tzAMS)
m = minute(timenow, tzAMS)
s = second(timenow, tzAMS)
timeStr = str.tostring(h,"00") + ":" + str.tostring(m,"00") + ":" + str.tostring(s,"00") + " أمستردام"

hNY = hour(timenow, tzNY)
mNY = minute(timenow, tzNY)

f_nextTs(th, tm) =>
    y = year(timenow, tzNY)
    mo = month(timenow, tzNY)
    d = dayofmonth(timenow, tzNY)
    ts = timestamp(tzNY, y, mo, d, th, tm, 0)
    ts <= timenow ? timestamp(tzNY, y, mo, d + 1, th, tm, 0) : ts

f_nextTsTZ(tz, th, tm) =>
    y = year(timenow, tz)
    mo = month(timenow, tz)
    d = dayofmonth(timenow, tz)
    ts = timestamp(tz, y, mo, d, th, tm, 0)
    ts <= timenow ? timestamp(tz, y, mo, d + 1, th, tm, 0) : ts

f_leftStr(ts) =>
    left = math.max(0, math.floor((ts - timenow) / 1000))
    str.tostring(math.floor(left / 3600), "00") + ":" + str.tostring(math.floor((left % 3600) / 60), "00") + ":" + str.tostring(left % 60, "00")

f_cBody(i) => math.max(math.abs(close[i] - open[i]), syminfo.mintick)
f_cRng(i) => math.max(high[i] - low[i], syminfo.mintick)
f_cWd(i) => math.min(close[i], open[i]) - low[i]
f_cWu(i) => high[i] - math.max(close[i], open[i])

tzLon = "Europe/London"
tzTok = "Asia/Tokyo"
hLon = hour(timenow, tzLon)
mLon = minute(timenow, tzLon)
hTok = hour(timenow, tzTok)
inAsiaNow = hTok >= 9 and hTok < 18
inLonNow  = (hLon > 8 or (hLon == 8 and mLon >= 0)) and (hLon < 16 or (hLon == 16 and mLon < 30))
inNyNow   = (hNY > 9 or (hNY == 9 and mNY >= 30)) and hNY < 16
inOvNow   = inLonNow and inNyNow
tAsia = time(timeframe.period, "0900-1800:1234567", tzTok)
tLon  = time(timeframe.period, "0800-1630:1234567", tzLon)
tNy   = time(timeframe.period, "0930-1600:1234567", tzNY)
var float pxAsia = na
var float pxLon = na
var float pxNy = na
if not na(tAsia) and na(tAsia[1])
    pxAsia := open
if not na(tLon) and na(tLon[1])
    pxLon := open
if not na(tNy) and na(tNy[1])
    pxNy := open
f_sessDir(px) => na(px) ? "محايد" : close > px ? "صعود" : close < px ? "هبوط" : "محايد"
f_sessCol(d) => d == "صعود" ? color.lime : d == "هبوط" ? color.red : color.gray
tsLonOpen = f_nextTsTZ(tzLon, 8, 0)
tsNyOpen  = f_nextTsTZ(tzNY, 9, 30)
tsAsiaOpen = f_nextTsTZ(tzTok, 9, 0)
tsLonEnd = f_nextTsTZ(tzLon, 16, 30)
tsNyEnd  = f_nextTsTZ(tzNY, 16, 0)
tsAsiaEnd = f_nextTsTZ(tzTok, 18, 0)
nearLon = not inLonNow and math.floor((tsLonOpen - timenow) / 60000) <= 15
nearNy  = not inNyNow and math.floor((tsNyOpen - timenow) / 60000) <= 15
sessName = "سيولة ضعيفة"
sessDir = "—"
sessLeftTs = tsAsiaOpen
sessCol = color.gray
if inOvNow
    sessName := "تداخل لندن-نيويورك"
    sessDir := f_sessDir(pxNy)
    sessLeftTs := tsLonEnd
    sessCol := f_sessCol(sessDir)
else if nearNy
    sessName := "اقتراب نيويورك"
    sessDir := "—"
    sessLeftTs := tsNyOpen
    sessCol := color.orange
else if inNyNow
    sessName := "نيويورك"
    sessDir := f_sessDir(pxNy)
    sessLeftTs := tsNyEnd
    sessCol := f_sessCol(sessDir)
else if nearLon
    sessName := "اقتراب لندن"
    sessDir := "—"
    sessLeftTs := tsLonOpen
    sessCol := color.orange
else if inLonNow
    sessName := "لندن"
    sessDir := f_sessDir(pxLon)
    sessLeftTs := tsLonEnd
    sessCol := f_sessCol(sessDir)
else if inAsiaNow
    sessName := "آسيا"
    sessDir := f_sessDir(pxAsia)
    sessLeftTs := tsAsiaEnd
    sessCol := f_sessCol(sessDir)
else
    sessName := "سيولة ضعيفة"
    sessDir := "—"
    sessLeftTs := tsAsiaOpen
    sessCol := color.gray
sessTxt = sessName + (sessDir == "—" ? "" : " | " + sessDir) + " · " + f_leftStr(sessLeftTs)

f_amsClock(ts) =>
    sameDay = year(ts, tzAMS) == year(timenow, tzAMS) and month(ts, tzAMS) == month(timenow, tzAMS) and dayofmonth(ts, tzAMS) == dayofmonth(timenow, tzAMS)
    tmrTs = timestamp(tzAMS, year(timenow, tzAMS), month(timenow, tzAMS), dayofmonth(timenow, tzAMS) + 1, 12, 0, 0)
    isTmr = year(ts, tzAMS) == year(tmrTs, tzAMS) and month(ts, tzAMS) == month(tmrTs, tzAMS) and dayofmonth(ts, tzAMS) == dayofmonth(tmrTs, tzAMS)
    hhmm = str.tostring(hour(ts, tzAMS), "00") + ":" + str.tostring(minute(ts, tzAMS), "00")
    dw = dayofweek(ts, tzAMS)
    dwAr = dw == dayofweek.sunday ? "الأحد" : dw == dayofweek.monday ? "الاثنين" : dw == dayofweek.tuesday ? "الثلاثاء" : dw == dayofweek.wednesday ? "الأربعاء" : dw == dayofweek.thursday ? "الخميس" : dw == dayofweek.friday ? "الجمعة" : "السبت"
    prefix = sameDay ? "" : isTmr ? "غداً " : dwAr + " " + str.tostring(dayofmonth(ts, tzAMS), "00") + "/" + str.tostring(month(ts, tzAMS), "00") + " "
    prefix + hhmm

FAR = timestamp("UTC", 2030, 1, 1, 0, 0, 0)
f_tsNY(y, mo, d, th, tm) => timestamp(tzNY, y, mo, d, th, tm, 0)
f_ifFut(ts) => ts > timenow ? ts : FAR
f_sameNY(ts) => year(timenow, tzNY) == year(ts, tzNY) and month(timenow, tzNY) == month(ts, tzNY) and dayofmonth(timenow, tzNY) == dayofmonth(ts, tzNY)
f_sameBar(ts) => year(time, tzNY) == year(ts, tzNY) and month(time, tzNY) == month(ts, tzNY) and dayofmonth(time, tzNY) == dayofmonth(ts, tzNY)

yNY = year(timenow, tzNY)
moNY = month(timenow, tzNY)
dmNY = dayofmonth(timenow, tzNY)

f_firstFri(y, mo) =>
    t1 = timestamp(tzNY, y, mo, 1, 8, 30, 0)
    add = (dayofweek.friday - dayofweek(t1, tzNY) + 7) % 7
    timestamp(tzNY, y, mo, 1 + add, 8, 30, 0)
nfpThis = f_firstFri(yNY, moNY)
nfpNextMo = moNY == 12 ? 1 : moNY + 1
nfpNextY  = moNY == 12 ? yNY + 1 : yNY
tsNFP = nfpThis > timenow ? nfpThis : f_firstFri(nfpNextY, nfpNextMo)

dwNow = dayofweek(timenow, tzNY)
addThu = (dayofweek.thursday - dwNow + 7) % 7
tsClaimsTry = timestamp(tzNY, yNY, moNY, dmNY + addThu, 8, 30, 0)
tsClaims = tsClaimsTry > timenow ? tsClaimsTry : timestamp(tzNY, yNY, moNY, dmNY + addThu + 7, 8, 30, 0)

c01 = f_tsNY(2026, 1, 13, 8, 30)
c02 = f_tsNY(2026, 2, 13, 8, 30)
c03 = f_tsNY(2026, 3, 11, 8, 30)
c04 = f_tsNY(2026, 4, 10, 8, 30)
c05 = f_tsNY(2026, 5, 12, 8, 30)
c06 = f_tsNY(2026, 6, 10, 8, 30)
c07 = f_tsNY(2026, 7, 14, 8, 30)
c08 = f_tsNY(2026, 8, 12, 8, 30)
c09 = f_tsNY(2026, 9, 11, 8, 30)
c10 = f_tsNY(2026, 10, 14, 8, 30)
c11 = f_tsNY(2026, 11, 10, 8, 30)
c12 = f_tsNY(2026, 12, 10, 8, 30)
ppiA = f_tsNY(2026, 9, 10, 8, 30)
ppiB = f_tsNY(2026, 10, 15, 8, 30)
ppiC = f_tsNY(2026, 11, 13, 8, 30)
ppiD = f_tsNY(2026, 12, 15, 8, 30)
pce0 = f_tsNY(2026, 8, 26, 8, 30)
pceA = f_tsNY(2026, 9, 30, 8, 30)
pceB = f_tsNY(2026, 10, 29, 8, 30)
pceC = f_tsNY(2026, 11, 25, 8, 30)
pceD = f_tsNY(2026, 12, 23, 8, 30)
ism1 = f_tsNY(2026, 9, 1, 10, 0)
ism2 = f_tsNY(2026, 10, 1, 10, 0)
ism3 = f_tsNY(2026, 11, 2, 10, 0)
ism4 = f_tsNY(2026, 12, 1, 10, 0)
iss1 = f_tsNY(2026, 9, 3, 10, 0)
iss2 = f_tsNY(2026, 10, 5, 10, 0)
iss3 = f_tsNY(2026, 11, 4, 10, 0)
iss4 = f_tsNY(2026, 12, 3, 10, 0)
jo1 = f_tsNY(2026, 9, 1, 10, 0)
jo2 = f_tsNY(2026, 9, 29, 10, 0)
jo3 = f_tsNY(2026, 11, 3, 10, 0)
jo4 = f_tsNY(2026, 12, 1, 10, 0)
bg1 = f_tsNY(2026, 9, 2, 14, 0)
bg2 = f_tsNY(2026, 10, 14, 14, 0)
bg3 = f_tsNY(2026, 11, 25, 14, 0)
mc1 = f_tsNY(2026, 9, 25, 10, 0)
mc2 = f_tsNY(2026, 10, 30, 10, 0)
mc3 = f_tsNY(2026, 11, 27, 10, 0)
mc4 = f_tsNY(2026, 12, 23, 10, 0)
mp1 = f_tsNY(2026, 9, 11, 10, 0)
mp2 = f_tsNY(2026, 10, 9, 10, 0)
mp3 = f_tsNY(2026, 11, 13, 10, 0)
mp4 = f_tsNY(2026, 12, 11, 10, 0)
ph1 = f_tsNY(2026, 9, 17, 8, 30)
ph2 = f_tsNY(2026, 10, 15, 8, 30)
ph3 = f_tsNY(2026, 11, 19, 8, 30)
ph4 = f_tsNY(2026, 12, 17, 8, 30)
rs1 = f_tsNY(2026, 9, 16, 8, 30)
rs2 = f_tsNY(2026, 10, 15, 8, 30)
rs3 = f_tsNY(2026, 11, 17, 8, 30)
rs4 = f_tsNY(2026, 12, 16, 8, 30)
gdpA = f_tsNY(2026, 9, 30, 8, 30)
gdpB = f_tsNY(2026, 10, 29, 8, 30)
gdpC = f_tsNY(2026, 11, 25, 8, 30)
gdpD = f_tsNY(2026, 12, 23, 8, 30)
cb1 = f_tsNY(2026, 9, 29, 10, 0)
cb2 = f_tsNY(2026, 10, 27, 10, 0)
cb3 = f_tsNY(2026, 11, 24, 10, 0)
cb4 = f_tsNY(2026, 12, 29, 10, 0)
dg1 = f_tsNY(2026, 9, 25, 8, 30)
dg2 = f_tsNY(2026, 10, 27, 8, 30)
dg3 = f_tsNY(2026, 11, 25, 8, 30)
dg4 = f_tsNY(2026, 12, 23, 8, 30)
hs1 = f_tsNY(2026, 9, 17, 8, 30)
hs2 = f_tsNY(2026, 10, 20, 8, 30)
hs3 = f_tsNY(2026, 11, 18, 8, 30)
hs4 = f_tsNY(2026, 12, 17, 8, 30)
nh1 = f_tsNY(2026, 9, 24, 10, 0)
