chi1 = f_tsNY(2026, 9, 30, 9, 45)
chi2 = f_tsNY(2026, 10, 30, 9, 45)
chi3 = f_tsNY(2026, 11, 30, 9, 45)
chi4 = f_tsNY(2026, 12, 30, 9, 45)
sp1 = f_tsNY(2026, 9, 1, 9, 45)
sp2 = f_tsNY(2026, 10, 1, 9, 45)
sp3 = f_tsNY(2026, 11, 2, 9, 45)
sp4 = f_tsNY(2026, 12, 1, 9, 45)
tr1 = f_tsNY(2026, 9, 3, 8, 30)
tr2 = f_tsNY(2026, 10, 6, 8, 30)
tr3 = f_tsNY(2026, 11, 4, 8, 30)
tr4 = f_tsNY(2026, 12, 8, 8, 30)
fo1 = f_tsNY(2026, 9, 2, 10, 0)
fo2 = f_tsNY(2026, 10, 2, 10, 0)
fo3 = f_tsNY(2026, 11, 3, 10, 0)
fo4 = f_tsNY(2026, 12, 3, 10, 0)
em1 = f_tsNY(2026, 9, 15, 8, 30)
em2 = f_tsNY(2026, 10, 15, 8, 30)
em3 = f_tsNY(2026, 11, 16, 8, 30)
em4 = f_tsNY(2026, 12, 15, 8, 30)
eh1 = f_tsNY(2026, 9, 10, 10, 0)
eh2 = f_tsNY(2026, 10, 13, 10, 0)
eh3 = f_tsNY(2026, 11, 12, 10, 0)
eh4 = f_tsNY(2026, 12, 9, 10, 0)
mn1 = f_tsNY(2026, 10, 7, 14, 0)
mn2 = f_tsNY(2026, 11, 18, 14, 0)
mn3 = f_tsNY(2026, 12, 30, 14, 0)
fl1 = f_tsNY(2026, 9, 24, 9, 45)
fl2 = f_tsNY(2026, 10, 23, 9, 45)
fl3 = f_tsNY(2026, 11, 20, 9, 45)
fl4 = f_tsNY(2026, 12, 16, 9, 45)
phs1 = f_tsNY(2026, 9, 17, 10, 0)
phs2 = f_tsNY(2026, 10, 20, 10, 0)
phs3 = f_tsNY(2026, 11, 18, 10, 0)
phs4 = f_tsNY(2026, 12, 17, 10, 0)
dal0 = f_tsNY(2026, 8, 31, 10, 30)
dal1 = f_tsNY(2026, 9, 28, 10, 30)
dal2 = f_tsNY(2026, 10, 26, 10, 30)
dal3 = f_tsNY(2026, 11, 30, 10, 30)
dal4 = f_tsNY(2026, 12, 28, 10, 30)
wh1 = f_tsNY(2026, 9, 10, 10, 0)
wh2 = f_tsNY(2026, 10, 8, 10, 0)
wh3 = f_tsNY(2026, 11, 9, 10, 0)
wh4 = f_tsNY(2026, 12, 9, 10, 0)
ip1 = f_tsNY(2026, 9, 18, 9, 15)
ip2 = f_tsNY(2026, 10, 16, 9, 15)
ip3 = f_tsNY(2026, 11, 17, 9, 15)
ip4 = f_tsNY(2026, 12, 16, 9, 15)
prd1 = f_tsNY(2026, 9, 3, 8, 30)
prd2 = f_tsNY(2026, 11, 5, 8, 30)
prd3 = f_tsNY(2026, 12, 8, 8, 30)
imp1 = f_tsNY(2026, 9, 16, 8, 30)
imp2 = f_tsNY(2026, 10, 16, 8, 30)
imp3 = f_tsNY(2026, 11, 17, 8, 30)
imp4 = f_tsNY(2026, 12, 17, 8, 30)
adpY = year(nfpThis > timenow ? nfpThis : f_firstFri(nfpNextY, nfpNextMo), tzNY)
adpMo = month(nfpThis > timenow ? nfpThis : f_firstFri(nfpNextY, nfpNextMo), tzNY)
adpD = dayofmonth(nfpThis > timenow ? nfpThis : f_firstFri(nfpNextY, nfpNextMo), tzNY)
tsADP0 = timestamp(tzNY, adpY, adpMo, adpD - 2, 8, 15, 0)
fm1 = f_tsNY(2026, 1, 28, 14, 0)
fm3 = f_tsNY(2026, 3, 18, 14, 0)
fm4 = f_tsNY(2026, 4, 29, 14, 0)
fm6 = f_tsNY(2026, 6, 17, 14, 0)
fm7 = f_tsNY(2026, 7, 29, 14, 0)
fm9 = f_tsNY(2026, 9, 16, 14, 0)
fm10 = f_tsNY(2026, 10, 28, 14, 0)
fm12 = f_tsNY(2026, 12, 9, 14, 0)
jhA = f_tsNY(2026, 8, 27, 8, 0)
jhB = f_tsNY(2026, 8, 28, 10, 0)

tsCPI  = math.min(f_ifFut(c01), f_ifFut(c02), f_ifFut(c03), f_ifFut(c04), f_ifFut(c05), f_ifFut(c06), f_ifFut(c07), f_ifFut(c08), f_ifFut(c09), f_ifFut(c10), f_ifFut(c11), f_ifFut(c12))
tsPPI  = math.min(f_ifFut(ppiA), f_ifFut(ppiB), f_ifFut(ppiC), f_ifFut(ppiD))
tsPCE  = math.min(f_ifFut(pce0), f_ifFut(pceA), f_ifFut(pceB), f_ifFut(pceC), f_ifFut(pceD))
tsFOMC = math.min(f_ifFut(fm1), f_ifFut(fm3), f_ifFut(fm4), f_ifFut(fm6), f_ifFut(fm7), f_ifFut(fm9), f_ifFut(fm10), f_ifFut(fm12))
tsFOMP = tsFOMC + 30 * 60 * 1000
tsJH   = math.min(f_ifFut(jhA), f_ifFut(jhB))
tsNFP  := f_ifFut(tsNFP)
tsClaims := f_ifFut(tsClaims)
tsISM  = math.min(f_ifFut(ism1), f_ifFut(ism2), f_ifFut(ism3), f_ifFut(ism4))
tsISMs = math.min(f_ifFut(iss1), f_ifFut(iss2), f_ifFut(iss3), f_ifFut(iss4))
tsJOLTS = math.min(f_ifFut(jo1), f_ifFut(jo2), f_ifFut(jo3), f_ifFut(jo4))
tsBeige = math.min(f_ifFut(bg1), f_ifFut(bg2), f_ifFut(bg3))
tsMich = math.min(f_ifFut(mc1), f_ifFut(mc2), f_ifFut(mc3), f_ifFut(mc4), f_ifFut(mp1), f_ifFut(mp2), f_ifFut(mp3), f_ifFut(mp4))
tsADP  = f_ifFut(tsADP0)
tsRetail = math.min(f_ifFut(rs1), f_ifFut(rs2), f_ifFut(rs3), f_ifFut(rs4))
tsGDP  = math.min(f_ifFut(gdpA), f_ifFut(gdpB), f_ifFut(gdpC), f_ifFut(gdpD))
tsConf = math.min(f_ifFut(cb1), f_ifFut(cb2), f_ifFut(cb3), f_ifFut(cb4))
tsDur  = math.min(f_ifFut(dg1), f_ifFut(dg2), f_ifFut(dg3), f_ifFut(dg4))
tsHouse = math.min(f_ifFut(hs1), f_ifFut(hs2), f_ifFut(hs3), f_ifFut(hs4))
tsNHS  = math.min(f_ifFut(nh1), f_ifFut(nh2), f_ifFut(nh3), f_ifFut(nh4))
tsChi  = math.min(f_ifFut(chi1), f_ifFut(chi2), f_ifFut(chi3), f_ifFut(chi4))
tsSPM  = math.min(f_ifFut(sp1), f_ifFut(sp2), f_ifFut(sp3), f_ifFut(sp4))
tsPhilly = math.min(f_ifFut(ph1), f_ifFut(ph2), f_ifFut(ph3), f_ifFut(ph4))
tsTrade = math.min(f_ifFut(tr1), f_ifFut(tr2), f_ifFut(tr3), f_ifFut(tr4))
tsFact = math.min(f_ifFut(fo1), f_ifFut(fo2), f_ifFut(fo3), f_ifFut(fo4))
tsEmp = math.min(f_ifFut(em1), f_ifFut(em2), f_ifFut(em3), f_ifFut(em4))
tsExist = math.min(f_ifFut(eh1), f_ifFut(eh2), f_ifFut(eh3), f_ifFut(eh4))
tsMins = math.min(f_ifFut(mn1), f_ifFut(mn2), f_ifFut(mn3))
tsFlash = math.min(f_ifFut(fl1), f_ifFut(fl2), f_ifFut(fl3), f_ifFut(fl4))
tsPend = math.min(f_ifFut(phs1), f_ifFut(phs2), f_ifFut(phs3), f_ifFut(phs4))
tsDallas = math.min(f_ifFut(dal0), f_ifFut(dal1), f_ifFut(dal2), f_ifFut(dal3), f_ifFut(dal4))
tsWhole = math.min(f_ifFut(wh1), f_ifFut(wh2), f_ifFut(wh3), f_ifFut(wh4))
tsIP = math.min(f_ifFut(ip1), f_ifFut(ip2), f_ifFut(ip3), f_ifFut(ip4))
tsProd = math.min(f_ifFut(prd1), f_ifFut(prd2), f_ifFut(prd3))
tsImp = math.min(f_ifFut(imp1), f_ifFut(imp2), f_ifFut(imp3), f_ifFut(imp4))

nearestTs = math.min(math.min(tsCPI, tsPPI, tsPCE, tsFOMC, tsFOMP, tsJH, tsNFP, tsClaims), math.min(tsISM, tsISMs, tsJOLTS, tsBeige, tsMich, tsADP, tsRetail, tsGDP), math.min(tsConf, tsDur, tsHouse, tsNHS, tsChi, tsSPM, tsPhilly), math.min(tsTrade, tsFact, tsEmp, tsExist, tsMins, tsFlash), math.min(tsPend, tsDallas, tsWhole, tsIP, tsProd, tsImp))
nearestName = nearestTs == tsJH ? "جاكسون هول" : nearestTs == tsFOMP ? "FOMC-P" : nearestTs == tsFOMC ? "FOMC" : nearestTs == tsMins ? "محضر FOMC" : nearestTs == tsPPI ? "PPI" : nearestTs == tsCPI ? "CPI" : nearestTs == tsPCE ? "PCE" : nearestTs == tsNFP ? "NFP" : nearestTs == tsClaims ? "Claims" : nearestTs == tsISM ? "ISM مصنع" : nearestTs == tsISMs ? "ISM خدمات" : nearestTs == tsJOLTS ? "JOLTS" : nearestTs == tsADP ? "ADP" : nearestTs == tsBeige ? "Beige" : nearestTs == tsMich ? "ميشيغان" : nearestTs == tsRetail ? "تجزئة" : nearestTs == tsGDP ? "GDP" : nearestTs == tsConf ? "ثقة المستهلك" : nearestTs == tsDur ? "سلع معمرة" : nearestTs == tsHouse ? "إسكان" : nearestTs == tsNHS ? "منازل جديدة" : nearestTs == tsExist ? "منازل قائمة" : nearestTs == tsPend ? "منازل معلقة" : nearestTs == tsChi ? "شيكاغو PMI" : nearestTs == tsSPM ? "PMI" : nearestTs == tsFlash ? "PMI أولي" : nearestTs == tsPhilly ? "فيلادلفيا" : nearestTs == tsDallas ? "دالاس Fed" : nearestTs == tsEmp ? "إمباير" : nearestTs == tsFact ? "طلبات مصانع" : nearestTs == tsTrade ? "تجارة" : nearestTs == tsWhole ? "مخزون جملة" : nearestTs == tsIP ? "إنتاج صناعي" : nearestTs == tsProd ? "إنتاجية" : nearestTs == tsImp ? "أسعار واردات" : "خبر"
nearestCD = nearestName + "  " + f_amsClock(nearestTs) + "  ·  " + f_leftStr(nearestTs) + " متبقي"
nearestLeft = math.max(0, math.floor((nearestTs - timenow) / 60000))

isThu = dwNow == dayofweek.thursday
isCpiDay  = f_sameNY(c01) or f_sameNY(c02) or f_sameNY(c03) or f_sameNY(c04) or f_sameNY(c05) or f_sameNY(c06) or f_sameNY(c07) or f_sameNY(c08) or f_sameNY(c09) or f_sameNY(c10) or f_sameNY(c11) or f_sameNY(c12)
isPpiDay  = f_sameNY(ppiA) or f_sameNY(ppiB) or f_sameNY(ppiC) or f_sameNY(ppiD)
isPceDay  = f_sameNY(pce0) or f_sameNY(pceA) or f_sameNY(pceB) or f_sameNY(pceC) or f_sameNY(pceD)
isNfpDay  = f_sameNY(tsNFP) or (dayofweek(timenow, tzNY) == dayofweek.friday and dmNY <= 7)
isFomcDay = f_sameNY(fm1) or f_sameNY(fm3) or f_sameNY(fm4) or f_sameNY(fm6) or f_sameNY(fm7) or f_sameNY(fm9) or f_sameNY(fm10) or f_sameNY(fm12)
isJh27    = f_sameNY(jhA)
isJh28    = f_sameNY(jhB)
isIsmDay  = f_sameNY(ism1) or f_sameNY(ism2) or f_sameNY(ism3) or f_sameNY(ism4)
isIsmsDay = f_sameNY(iss1) or f_sameNY(iss2) or f_sameNY(iss3) or f_sameNY(iss4)
isJoltsDay = f_sameNY(jo1) or f_sameNY(jo2) or f_sameNY(jo3) or f_sameNY(jo4)
isBeigeDay = f_sameNY(bg1) or f_sameNY(bg2) or f_sameNY(bg3)
isMichDay = f_sameNY(mc1) or f_sameNY(mc2) or f_sameNY(mc3) or f_sameNY(mc4) or f_sameNY(mp1) or f_sameNY(mp2) or f_sameNY(mp3) or f_sameNY(mp4)
isAdpDay  = f_sameNY(tsADP0)
isRetailDay = f_sameNY(rs1) or f_sameNY(rs2) or f_sameNY(rs3) or f_sameNY(rs4)
isGdpDay = f_sameNY(gdpA) or f_sameNY(gdpB) or f_sameNY(gdpC) or f_sameNY(gdpD)
isConfDay = f_sameNY(cb1) or f_sameNY(cb2) or f_sameNY(cb3) or f_sameNY(cb4)
isDurDay = f_sameNY(dg1) or f_sameNY(dg2) or f_sameNY(dg3) or f_sameNY(dg4)
isHouseDay = f_sameNY(hs1) or f_sameNY(hs2) or f_sameNY(hs3) or f_sameNY(hs4)
isNhsDay = f_sameNY(nh1) or f_sameNY(nh2) or f_sameNY(nh3) or f_sameNY(nh4)
isChiDay = f_sameNY(chi1) or f_sameNY(chi2) or f_sameNY(chi3) or f_sameNY(chi4)
isSpmDay = f_sameNY(sp1) or f_sameNY(sp2) or f_sameNY(sp3) or f_sameNY(sp4)
isPhillyDay = f_sameNY(ph1) or f_sameNY(ph2) or f_sameNY(ph3) or f_sameNY(ph4)
isTradeDay = f_sameNY(tr1) or f_sameNY(tr2) or f_sameNY(tr3) or f_sameNY(tr4)
isFactDay = f_sameNY(fo1) or f_sameNY(fo2) or f_sameNY(fo3) or f_sameNY(fo4)
isEmpDay = f_sameNY(em1) or f_sameNY(em2) or f_sameNY(em3) or f_sameNY(em4)
isExistDay = f_sameNY(eh1) or f_sameNY(eh2) or f_sameNY(eh3) or f_sameNY(eh4)
isMinsDay = f_sameNY(mn1) or f_sameNY(mn2) or f_sameNY(mn3)
isFlashDay = f_sameNY(fl1) or f_sameNY(fl2) or f_sameNY(fl3) or f_sameNY(fl4)
isPendDay = f_sameNY(phs1) or f_sameNY(phs2) or f_sameNY(phs3) or f_sameNY(phs4)
isDallasDay = f_sameNY(dal0) or f_sameNY(dal1) or f_sameNY(dal2) or f_sameNY(dal3) or f_sameNY(dal4)
isWholeDay = f_sameNY(wh1) or f_sameNY(wh2) or f_sameNY(wh3) or f_sameNY(wh4)
isIpDay = f_sameNY(ip1) or f_sameNY(ip2) or f_sameNY(ip3) or f_sameNY(ip4)
isProdDay = f_sameNY(prd1) or f_sameNY(prd2) or f_sameNY(prd3)
isImpDay = f_sameNY(imp1) or f_sameNY(imp2) or f_sameNY(imp3) or f_sameNY(imp4)

w0830 = hNY == 8 and mNY >= 28 and mNY <= 38
w0815 = hNY == 8 and mNY >= 13 and mNY <= 25
w0915 = hNY == 9 and mNY >= 13 and mNY <= 25
w0945 = hNY == 9 and mNY >= 43 and mNY <= 55
w1000 = (hNY == 9 and mNY >= 58) or (hNY == 10 and mNY <= 20)
w1030 = hNY == 10 and mNY >= 28 and mNY <= 40
w1400 = (hNY == 13 and mNY >= 58) or (hNY == 14 and mNY <= 18)
w1430 = hNY == 14 and mNY >= 28 and mNY <= 50

isHighImpact = ((isCpiDay or isPpiDay or isPceDay or isNfpDay or isThu or isRetailDay or isGdpDay or isDurDay or isHouseDay or isPhillyDay or isTradeDay or isEmpDay or isProdDay or isImpDay) and w0830) or (isFomcDay and (w1400 or w1430)) or (isMinsDay and w1400) or (isJh27 and hNY >= 7 and hNY <= 12) or (isJh28 and w1000) or ((isIsmDay or isIsmsDay or isJoltsDay or isMichDay or isConfDay or isNhsDay or isFactDay or isExistDay or isPendDay or isWholeDay) and w1000) or (isDallasDay and w1030) or (isIpDay and w0915) or (isAdpDay and w0815) or (isBeigeDay and w1400) or ((isChiDay or isSpmDay or isFlashDay) and w0945)
approaching = nearestLeft <= 12 and nearestLeft > 0
newsStatus = isHighImpact ? "نشط الآن" : approaching ? "اقتراب" : "آمن"
newsCol = isHighImpact ? color.red : approaching ? color.orange : color.lime

hBar = hour(time, tzNY)
mBar = minute(time, tzNY)
isThuBar = dayofweek(time, tzNY) == dayofweek.thursday
isCpiBar  = f_sameBar(c01) or f_sameBar(c02) or f_sameBar(c03) or f_sameBar(c04) or f_sameBar(c05) or f_sameBar(c06) or f_sameBar(c07) or f_sameBar(c08) or f_sameBar(c09) or f_sameBar(c10) or f_sameBar(c11) or f_sameBar(c12)
isPpiBar  = f_sameBar(ppiA) or f_sameBar(ppiB) or f_sameBar(ppiC) or f_sameBar(ppiD)
isPceBar  = f_sameBar(pce0) or f_sameBar(pceA) or f_sameBar(pceB) or f_sameBar(pceC) or f_sameBar(pceD)
isNfpBar  = dayofweek(time, tzNY) == dayofweek.friday and dayofmonth(time, tzNY) <= 7
isFomcBar = f_sameBar(fm1) or f_sameBar(fm3) or f_sameBar(fm4) or f_sameBar(fm6) or f_sameBar(fm7) or f_sameBar(fm9) or f_sameBar(fm10) or f_sameBar(fm12)
isJh27Bar = f_sameBar(jhA)
isJh28Bar = f_sameBar(jhB)
isIsmBar  = f_sameBar(ism1) or f_sameBar(ism2) or f_sameBar(ism3) or f_sameBar(ism4)
isIsmsBar = f_sameBar(iss1) or f_sameBar(iss2) or f_sameBar(iss3) or f_sameBar(iss4)
isJoltsBar = f_sameBar(jo1) or f_sameBar(jo2) or f_sameBar(jo3) or f_sameBar(jo4)
isBeigeBar = f_sameBar(bg1) or f_sameBar(bg2) or f_sameBar(bg3)
isMichBar = f_sameBar(mc1) or f_sameBar(mc2) or f_sameBar(mc3) or f_sameBar(mc4) or f_sameBar(mp1) or f_sameBar(mp2) or f_sameBar(mp3) or f_sameBar(mp4)
isAdpBar  = f_sameBar(tsADP0)
isRetailBar = f_sameBar(rs1) or f_sameBar(rs2) or f_sameBar(rs3) or f_sameBar(rs4)
isGdpBar = f_sameBar(gdpA) or f_sameBar(gdpB) or f_sameBar(gdpC) or f_sameBar(gdpD)
isConfBar = f_sameBar(cb1) or f_sameBar(cb2) or f_sameBar(cb3) or f_sameBar(cb4)
isDurBar = f_sameBar(dg1) or f_sameBar(dg2) or f_sameBar(dg3) or f_sameBar(dg4)
isHouseBar = f_sameBar(hs1) or f_sameBar(hs2) or f_sameBar(hs3) or f_sameBar(hs4)
isNhsBar = f_sameBar(nh1) or f_sameBar(nh2) or f_sameBar(nh3) or f_sameBar(nh4)
isChiBar = f_sameBar(chi1) or f_sameBar(chi2) or f_sameBar(chi3) or f_sameBar(chi4)
isSpmBar = f_sameBar(sp1) or f_sameBar(sp2) or f_sameBar(sp3) or f_sameBar(sp4)
isPhillyBar = f_sameBar(ph1) or f_sameBar(ph2) or f_sameBar(ph3) or f_sameBar(ph4)
isTradeBar = f_sameBar(tr1) or f_sameBar(tr2) or f_sameBar(tr3) or f_sameBar(tr4)
isFactBar = f_sameBar(fo1) or f_sameBar(fo2) or f_sameBar(fo3) or f_sameBar(fo4)
isEmpBar = f_sameBar(em1) or f_sameBar(em2) or f_sameBar(em3) or f_sameBar(em4)
isExistBar = f_sameBar(eh1) or f_sameBar(eh2) or f_sameBar(eh3) or f_sameBar(eh4)
isMinsBar = f_sameBar(mn1) or f_sameBar(mn2) or f_sameBar(mn3)
isFlashBar = f_sameBar(fl1) or f_sameBar(fl2) or f_sameBar(fl3) or f_sameBar(fl4)
isPendBar = f_sameBar(phs1) or f_sameBar(phs2) or f_sameBar(phs3) or f_sameBar(phs4)
isDallasBar = f_sameBar(dal0) or f_sameBar(dal1) or f_sameBar(dal2) or f_sameBar(dal3) or f_sameBar(dal4)
isWholeBar = f_sameBar(wh1) or f_sameBar(wh2) or f_sameBar(wh3) or f_sameBar(wh4)
isIpBar = f_sameBar(ip1) or f_sameBar(ip2) or f_sameBar(ip3) or f_sameBar(ip4)
isProdBar = f_sameBar(prd1) or f_sameBar(prd2) or f_sameBar(prd3)
isImpBar = f_sameBar(imp1) or f_sameBar(imp2) or f_sameBar(imp3) or f_sameBar(imp4)
w0830Bar = hBar == 8 and mBar >= 28 and mBar <= 38
w0815Bar = hBar == 8 and mBar >= 13 and mBar <= 25
w0915Bar = hBar == 9 and mBar >= 13 and mBar <= 25
w0945Bar = hBar == 9 and mBar >= 43 and mBar <= 55
w1000Bar = (hBar == 9 and mBar >= 58) or (hBar == 10 and mBar <= 20)
w1030Bar = hBar == 10 and mBar >= 28 and mBar <= 40
w1400Bar = (hBar == 13 and mBar >= 58) or (hBar == 14 and mBar <= 18)
w1430Bar = hBar == 14 and mBar >= 28 and mBar <= 50
isHighImpactBar = ((isCpiBar or isPpiBar or isPceBar or isNfpBar or isThuBar or isRetailBar or isGdpBar or isDurBar or isHouseBar or isPhillyBar or isTradeBar or isEmpBar or isProdBar or isImpBar) and w0830Bar) or (isFomcBar and (w1400Bar or w1430Bar)) or (isMinsBar and w1400Bar) or (isJh27Bar and hBar >= 7 and hBar <= 12) or (isJh28Bar and w1000Bar) or ((isIsmBar or isIsmsBar or isJoltsBar or isMichBar or isConfBar or isNhsBar or isFactBar or isExistBar or isPendBar or isWholeBar) and w1000Bar) or (isDallasBar and w1030Bar) or (isIpBar and w0915Bar) or (isAdpBar and w0815Bar) or (isBeigeBar and w1400Bar) or ((isChiBar or isSpmBar or isFlashBar) and w0945Bar)
f_nearBar(ts) =>
    leftM = hour(ts, tzNY) * 60 + minute(ts, tzNY) - (hBar * 60 + mBar)
    f_sameBar(ts) and leftM <= 12 and leftM > 0
approachingBar = f_nearBar(nearestTs) or (isThuBar and hBar == 8 and mBar >= 18 and mBar < 28)


emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi     = ta.rsi(close, rsiLen)
volSma  = ta.sma(volume, volLen)
rvol    = volSma > 0 ? volume / volSma : 1.0
atr     = ta.atr(10)
vwapVal = ta.vwap(hlc3)
emaUp = emaFast > emaSlow
emaDn = emaFast < emaSlow
aboveFast = close > emaFast
aboveSlow = close > emaSlow
strongVol = rvol >= 1.25
weakVol = rvol < 0.8
bullImpulse = close > open and (close - open) >= atr * 0.50
bearImpulse = close < open and (open - close) >= atr * 0.50
flowLong = close > open and (strongVol or bullImpulse)
flowShort = close < open and (strongVol or bearImpulse)
ema5Up = emaFast > emaFast[1]
ema5Dn = emaFast < emaFast[1]

tfSec = timeframe.in_seconds()
htfTF = tfSec <= 180 ? "5" : tfSec <= 300 ? "15" : "60"
htfFast = request.security(syminfo.tickerid, htfTF, ta.ema(close, emaFastLen), barmerge.gaps_off, barmerge.lookahead_off)
htfSlow = request.security(syminfo.tickerid, htfTF, ta.ema(close, emaSlowLen), barmerge.gaps_off, barmerge.lookahead_off)
htfUp = htfFast > htfSlow
htfName = htfTF == "5" ? "5m" : htfTF == "15" ? "15m" : "1H"
tf15Up = request.security(syminfo.tickerid, "15", ta.ema(close, emaFastLen) > ta.ema(close, emaSlowLen), barmerge.gaps_off, barmerge.lookahead_off)
btcUp = request.security("BINANCE:BTCUSDT", "5", ta.ema(close, 5) > ta.ema(close, 13), barmerge.gaps_off, barmerge.lookahead_off)
tfAgreeBuy = emaUp and htfUp
tfAgreeSell = emaDn and not htfUp
hardBlockBuy = not htfUp and tfSec <= 300
hardBlockSell = htfUp and tfSec <= 300

rngLen = tfSec <= 180 ? 8 : tfSec <= 300 ? 8 : 6
atrN = nz(atr, close * 0.002)
hi6 = ta.highest(high[1], 6)
lo6 = ta.lowest(low[1], 6)
hi8 = ta.highest(high[1], 8)
lo8 = ta.lowest(low[1], 8)
hi12 = ta.highest(high[1], 12)
lo12 = ta.lowest(low[1], 12)
w6 = hi6 - lo6
w8 = hi8 - lo8
w12 = hi12 - lo12
int workLen = 6
boxHi = hi6
boxLo = lo6
if w8 <= atrN * 2.25
    workLen := 8
    boxHi := hi8
    boxLo := lo8
if w12 <= atrN * 2.15
    workLen := 12
    boxHi := hi12
    boxLo := lo12
boxMid = (boxHi + boxLo) * 0.5
boxW = math.max(boxHi - boxLo, syminfo.mintick)
inBox = close <= boxHi and close >= boxLo
nearHi = (boxHi - close) <= atrN * 0.38 or high >= boxHi - atrN * 0.18
nearLo = (close - boxLo) <= atrN * 0.38 or low <= boxLo + atrN * 0.18
posBox = (close - boxLo) / boxW

int tapsHi = 0
int tapsLo = 0
for i = 1 to workLen
    if high[i] >= boxHi - atrN * 0.22
        tapsHi += 1
    if low[i] <= boxLo + atrN * 0.22
        tapsLo += 1

tight = boxW <= atrN * 1.70
inRange = tight or (boxW <= atrN * 2.25 and tapsHi >= 2 and tapsLo >= 2)

dispUp = (close - close[5]) >= atrN * 2.0 and close > open[2]
dispDn = (close[5] - close) >= atrN * 2.0 and close < open[2]
runUp = emaUp and close > emaSlow and close > ta.lowest(low, 12) + atrN * 1.8
runDn = emaDn and close < emaSlow and close < ta.highest(high, 12) - atrN * 1.8
stretchedUp = close > boxHi + atrN * 0.45
stretchedDn = close < boxLo - atrN * 0.45
atEma = math.abs(close - emaFast) <= atrN * 0.38
atVwap = math.abs(close - vwapVal) <= atrN * 0.45
holdEmaL = low[1] <= emaFast[1] and close > emaFast and close > open
holdVwapL = not na(vwapVal) and low[1] <= vwapVal[1] and close > vwapVal and close > open
holdEmaS = high[1] >= emaFast[1] and close < emaFast and close < open
holdVwapS = not na(vwapVal) and high[1] >= vwapVal[1] and close < vwapVal and close < open

body1 = f_cBody(1)
rng1 = f_cRng(1)
wd1 = f_cWd(1)
wu1 = f_cWu(1)
pos1 = (close[1] - low[1]) / rng1
hammer1 = wd1 >= body1 * 1.6 and wd1 >= atrN * 0.35 and wu1 <= body1 * 0.8 and pos1 >= 0.55
star1 = wu1 >= body1 * 1.6 and wu1 >= atrN * 0.35 and wd1 <= body1 * 0.8 and pos1 <= 0.45

sweepLo = low < boxLo and close > boxLo and close > open
sweepHi = high > boxHi and close < boxHi and close < open
sweepLoC = low[1] < boxLo[1] and close[1] > boxLo[1] and close[1] > open[1]
sweepHiC = high[1] > boxHi[1] and close[1] < boxHi[1] and close[1] < open[1]
reclaimLo = sweepLoC and close >= close[1] and close > boxLo
reclaimHi = sweepHiC and close <= close[1] and close < boxHi
closedOk = barstate.isconfirmed
brkUpLive = close > boxHi and close[1] <= boxHi and (strongVol or bullImpulse or ema5Up) and not stretchedUp
brkDnLive = close < boxLo and close[1] >= boxLo and (strongVol or bearImpulse or ema5Dn) and not stretchedDn
brkUp = brkUpLive and closedOk
brkDn = brkDnLive and closedOk
atrExpand = atr > atr[4] * 1.12
flagUp = runUp and inBox and not dispUp
flagDn = runDn and inBox and not dispDn
inLowHalf = close <= boxMid
inHighHalf = close >= boxMid
pullBuyLive = (runUp or flagUp) and inLowHalf and (hammer1 or holdEmaL or holdVwapL or (nearLo and close > open)) and close > boxLo
pullSellLive = (runDn or flagDn) and inHighHalf and (star1 or holdEmaS or holdVwapS or (nearHi and close < open)) and close < boxHi
pullBuy = pullBuyLive and closedOk
pullSell = pullSellLive and closedOk

st = "تجميع"
stCol = color.gray
if dispUp
    st := "اندفاع صعود"
    stCol := color.lime
else if dispDn
    st := "اندفاع هبوط"
    stCol := color.red
else if sweepLo or sweepLoC
    st := "كنس قاع"
    stCol := color.lime
else if sweepHi or sweepHiC
    st := "كنس قمة"
    stCol := color.red
else if brkUp
    st := "كسر صعود"
    stCol := color.lime
else if brkDn
    st := "كسر هبوط"
    stCol := color.red
else if flagUp
    st := "علم صعود"
    stCol := color.lime
else if flagDn
    st := "علم هبوط"
    stCol := color.red
else if tight
    st := "نطاق ضيق"
    stCol := color.orange
else if inRange
    st := "نطاق يتكرر"
    stCol := color.orange
else if atrExpand
    st := "توسّع"
    stCol := color.yellow
else if runUp
    st := "زخم صعود"
    stCol := color.lime
else if runDn
    st := "زخم هبوط"
    stCol := color.red

rngTxt = str.tostring(boxLo, "#.##") + " – " + str.tostring(boxHi, "#.##") + " | لمس " + str.tostring(tapsLo) + " تحت / " + str.tostring(tapsHi) + " فوق"
rngCol = inRange or flagUp or flagDn ? color.orange : runUp ? color.lime : runDn ? color.red : color.gray

candleTxt = hammer1 ? "مطرقة | رفض قاع" : star1 ? "نجم | رفض قمة" : sweepLoC ? "كنس قاع مغلق" : sweepHiC ? "كنس قمة مغلق" : "عادية"
candleCol = hammer1 or sweepLoC ? color.lime : star1 or sweepHiC ? color.red : color.gray

bigBuy = rvol >= 2.0 and close > open
bigSell = rvol >= 2.0 and close < open
whaleTxt = bigBuy ? "شراء كمية كبيرة" : bigSell ? "بيع كمية كبيرة" : "عادي"
whaleCol = bigBuy ? color.lime : bigSell ? color.red : color.gray
rvolText = bullImpulse and strongVol ? "دفعة + حجم | صعود" : bearImpulse and strongVol ? "دفعة + حجم | هبوط" : strongVol ? (close > open ? "قوي صعود" : "قوي هبوط") : weakVol ? "ضعيف" : "عادي"
rvolCol = flowLong ? color.lime : flowShort ? color.red : weakVol ? color.orange : color.gray
dirTxt = (tfAgreeBuy ? "متفق صعود" : tfAgreeSell ? "متفق هبوط" : "مختلف") + " | " + htfName + (htfUp ? " ص" : " ه") + " · 15م " + (tf15Up ? "ص" : "ه") + (btcUp ? " · BTC ص" : " · BTC ه")
dirCol = tfAgreeBuy ? color.lime : tfAgreeSell ? color.red : color.orange

raw = "انتظار"
if pullBuy or reclaimLo or (sweepLoC and hammer1) or brkUp
    raw := "شراء"
else if pullSell or reclaimHi or (sweepHiC and star1) or brkDn
    raw := "بيع"
else if runUp and htfUp
    raw := "شراء"
else if runDn and not htfUp
    raw := "بيع"

mxLive = mxEntry > 0 and mxCont > 0
mxLiveLong = mxLive and mxSide == "شراء"
mxLiveShort = mxLive and mxSide == "بيع"
var string rec = "انتظار"
var string lastSide = "انتظار"
var int waitBars = 0
blockedFlip = false
if mxLiveLong and raw == "بيع"
    blockedFlip := true
    rec := close < boxLo ? "انتظار" : "شراء"
else if mxLiveShort and raw == "شراء"
    blockedFlip := true
    rec := close > boxHi ? "انتظار" : "بيع"
else if raw == lastSide or lastSide == "انتظار" or rec == "انتظار"
    rec := raw
else if raw != "انتظار" and raw != lastSide
    if waitBars >= 2 and barstate.isconfirmed
        rec := raw
    else
        blockedFlip := true
        rec := "انتظار"
else
    rec := raw

if rec == "شراء" or rec == "بيع"
    lastSide := rec
    waitBars := 0
else
    waitBars += 1

var int sigBar = na
var string sigKind = ""
var float sigLvl = na
var int failUntil = 0
trigBuy = rec == "شراء" and (pullBuy or reclaimLo or brkUp or (sweepLoC and hammer1))
trigSell = rec == "بيع" and (pullSell or reclaimHi or brkDn or (sweepHiC and star1))
if trigBuy and closedOk
    sigBar := bar_index
    sigKind := brkUp ? "brkL" : (reclaimLo or sweepLoC) ? "swpL" : "pullL"
    sigLvl := brkUp ? boxHi : math.min(boxLo, emaFast)
if trigSell and closedOk
    sigBar := bar_index
    sigKind := brkDn ? "brkS" : (reclaimHi or sweepHiC) ? "swpS" : "pullS"
    sigLvl := brkDn ? boxLo : math.max(boxHi, emaFast)
failBuy = not na(sigBar) and (sigKind == "brkL" or sigKind == "pullL" or sigKind == "swpL") and bar_index > sigBar and bar_index <= sigBar + 3 and closedOk and close < sigLvl
failSell = not na(sigBar) and (sigKind == "brkS" or sigKind == "pullS" or sigKind == "swpS") and bar_index > sigBar and bar_index <= sigBar + 3 and closedOk and close > sigLvl
failNow = failBuy or failSell
if failNow
    rec := "انتظار"
    blockedFlip := true
    failUntil := bar_index + 2
    sigBar := na
    sigKind := ""
if bar_index < failUntil
    blockedFlip := true
    if rec != lastSide
        rec := "انتظار"

hasTrade = rec == "شراء" or rec == "بيع"
pullPx = rec == "شراء" ? math.max(emaFast, boxLo) : rec == "بيع" ? math.min(emaFast, boxHi) : na
slP = rec == "شراء" ? math.min(boxLo, low[1]) - atrN * 0.10 : rec == "بيع" ? math.max(boxHi, high[1]) + atrN * 0.10 : na
tpP = rec == "شراء" ? (nearLo or st == "كنس قاع" ? boxHi : close + atrN * 1.05) : rec == "بيع" ? (nearHi or st == "كنس قمة" ? boxLo : close - atrN * 1.05) : na
lvTxt = hasTrade and not na(slP) ? "وقف " + str.tostring(slP, "#.##") + " | هدف " + str.tostring(tpP, "#.##") : "—"
lvCol = hasTrade ? rec == "شراء" ? color.lime : color.red : color.gray

enterNowBuy = rec == "شراء" and not mxLive and not failNow and (pullBuy or reclaimLo or brkUp or (sweepLoC and hammer1))
enterNowSell = rec == "بيع" and not mxLive and not failNow and (pullSell or reclaimHi or brkDn or (sweepHiC and star1))
hiStr = str.tostring(boxHi, "#.##")
loStr = str.tostring(boxLo, "#.##")
emaStr = str.tostring(emaFast, "#.##")
unstLong = mxLiveLong and (close < boxLo or (close < boxHi and high[1] >= boxHi) or (close < emaFast and close < boxMid and ema5Dn))
unstShort = mxLiveShort and (close > boxHi or (close > boxLo and low[1] <= boxLo) or (close > emaFast and close > boxMid and ema5Up))

enterTxt = "لا تدخل"
enterCol = color.gray
if failNow
    enterTxt := "اخرج إن دخلت | لم يستقر — لا تعكس"
    enterCol := color.orange
    st := "فشل — لم يستقر"
    stCol := color.orange
else if mxLive and (unstLong or unstShort)
    enterTxt := "اخرج | لم يستقر — لا تعكس"
    enterCol := color.orange
else if mxLive
    if (mxLiveLong and rec == "بيع") or (mxLiveShort and rec == "شراء") or (blockedFlip and rec == "انتظار")
        enterTxt := "اخرج فقط — لا تعكس"
        enterCol := color.orange
    else
        enterTxt := "صفقتك قائمة — لا تضيف"
        enterCol := mxLiveLong ? color.lime : color.red
else if isHighImpact
    enterTxt := "لا تدخل — نافذة خبر"
    enterCol := color.red
else if brkUpLive and not closedOk
    enterTxt := "كسر يتشكل — ادخل بعد إغلاق فوق " + hiStr
    enterCol := color.yellow
else if brkDnLive and not closedOk
    enterTxt := "كسر يتشكل — ادخل بعد إغلاق تحت " + loStr
    enterCol := color.yellow
else if pullBuyLive and not closedOk
    enterTxt := "رجوع يتشكل — ادخل بعد إغلاق فوق " + emaStr
    enterCol := color.yellow
else if pullSellLive and not closedOk
    enterTxt := "رجوع يتشكل — ادخل بعد إغلاق تحت " + emaStr
    enterCol := color.yellow
else if enterNowBuy
    enterTxt := brkUp ? "ادخل شراء الآن | كسر " + hiStr : st == "كنس قاع" ? "ادخل شراء الآن | كنس القاع" : "ادخل شراء الآن | رجوع العلم"
    enterCol := color.lime
else if enterNowSell
    enterTxt := brkDn ? "ادخل بيع الآن | كسر " + loStr : st == "كنس قمة" ? "ادخل بيع الآن | كنس القمة" : "ادخل بيع الآن | رجوع العلم"
    enterCol := color.red
else if dispUp or stretchedUp
    enterTxt := "لا تدخل أثناء الاندفاع | انتظر رجوع " + emaStr
    enterCol := color.orange
else if dispDn or stretchedDn
    enterTxt := "لا تدخل أثناء الاندفاع | انتظر رجوع " + emaStr
    enterCol := color.orange
else if rec == "شراء" and nearHi
    enterTxt := "شراء — لا تدخل عند القمة | كسر " + hiStr + " أو رجوع " + emaStr
    enterCol := color.yellow
else if rec == "بيع" and nearLo
    enterTxt := "بيع — لا تدخل عند القاع | كسر " + loStr + " أو رجوع " + emaStr
    enterCol := color.yellow
else if rec == "شراء" and nearLo
    enterTxt := "شراء — جاهز عند ثبات " + loStr
    enterCol := color.yellow
else if rec == "بيع" and nearHi
    enterTxt := "بيع — جاهز عند ثبات " + hiStr
    enterCol := color.yellow
else if rec == "شراء"
    enterTxt := "شراء — انتظر رجوع " + emaStr + " أو كسر " + hiStr
    enterCol := color.yellow
else if rec == "بيع"
    enterTxt := "بيع — انتظر رجوع " + emaStr + " أو كسر " + loStr
    enterCol := color.yellow
else if blockedFlip
    enterTxt := "لا تدخل — ممنوع العكس السريع"
    enterCol := color.orange
else if nearLo
    enterTxt := "انتظر كنس أو ثبات القاع " + loStr
    enterCol := color.orange
else if nearHi
    enterTxt := "انتظر كنس أو كسر القمة " + hiStr
    enterCol := color.orange
else if inRange
    enterTxt := "لا تدخل | وسط النطاق"
    enterCol := color.gray
else
    enterTxt := "لا تدخل"
recShow = rec + " → " + enterTxt

advice = failNow or unstLong or unstShort ? "الكسر/الرجوع لم يستقر — اخرج فقط ولا تعكس" : dispUp ? "اندفاع تم — لا تطارد القمة، رجوع أو كسر" : dispDn ? "اندفاع هبوط — لا تطارد القاع" : flagUp ? "علم بعد الصعود — الدخول من الرجوع أو كسر السقف" : flagDn ? "علم بعد الهبوط — الدخول من الرجوع أو كسر القاع" : st == "كنس قاع" ? "السيولة تحت أُخذت — الهدف سقف النطاق" : st == "كنس قمة" ? "السيولة فوق أُخذت — الهدف قاع النطاق" : st == "كسر صعود" ? "كسر مع حجم — لا تعاكس" : st == "كسر هبوط" ? "كسر مع حجم — لا تعاكس" : inRange ? "لا وسط الصندوق على رافعة عالية" : rec == "شراء" ? "الاتجاه شراء — انتظر الحافة" : rec == "بيع" ? "الاتجاه بيع — انتظر الحافة" : "لا إشارة دخول الآن"
adviceCol = enterCol

dxyN = request.security("TVC:DXY", "1", close, barmerge.gaps_off, barmerge.lookahead_off)
dxyP = request.security("TVC:DXY", "1", close[15], barmerge.gaps_off, barmerge.lookahead_off)
y2N = request.security("TVC:US02Y", "1", close, barmerge.gaps_off, barmerge.lookahead_off)
y2P = request.security("TVC:US02Y", "1", close[15], barmerge.gaps_off, barmerge.lookahead_off)
y10N = request.security("TVC:US10Y", "1", close, barmerge.gaps_off, barmerge.lookahead_off)
y10P = request.security("TVC:US10Y", "1", close[15], barmerge.gaps_off, barmerge.lookahead_off)
btcN = request.security("BINANCE:BTCUSDT", "1", close, barmerge.gaps_off, barmerge.lookahead_off)
btcP = request.security("BINANCE:BTCUSDT", "1", close[15], barmerge.gaps_off, barmerge.lookahead_off)
solN = request.security(syminfo.tickerid, "1", close, barmerge.gaps_off, barmerge.lookahead_off)
solP = request.security(syminfo.tickerid, "1", close[15], barmerge.gaps_off, barmerge.lookahead_off)
dxyCh = not na(dxyN) and not na(dxyP) and dxyP != 0 ? (dxyN - dxyP) / dxyP * 100.0 : 0.0
y2Ch = not na(y2N) and not na(y2P) ? y2N - y2P : 0.0
y10Ch = not na(y10N) and not na(y10P) ? y10N - y10P : 0.0
btcRet = not na(btcN) and not na(btcP) and btcP != 0 ? (btcN - btcP) / btcP * 100.0 : 0.0
solRet = not na(solN) and not na(solP) and solP != 0 ? (solN - solP) / solP * 100.0 : 0.0
atrS = nz(atr, close * 0.01)
already = atrS > 0 and not na(solN) and not na(solP) ? math.abs(solN - solP) / atrS : 0.0
haveMacro = not na(dxyN)
int scH = 0
int scD = 0
if dxyCh > 0.04
    scH += 2
else if dxyCh < -0.04
    scD += 2
if not na(y2N) ? y2Ch > 0.015 : y10Ch > 0.012
    scH += 2
else if not na(y2N) ? y2Ch < -0.015 : y10Ch < -0.012
    scD += 2
if btcRet < -0.10
    scH += 1
else if btcRet > 0.10
    scD += 1
if solRet < -0.12
    scH += 1
else if solRet > 0.12
    scD += 1
rawHawk = scH >= 3 and scH >= scD + 2
rawDove = scD >= 3 and scD >= scH + 2
pricedHawk = rawHawk and already >= 0.75 and solRet < 0
pricedDove = rawDove and already >= 0.75 and solRet > 0
autoBias = not haveMacro ? "محايد" : pricedHawk or pricedDove ? "محايد" : rawHawk ? "تشديد" : rawDove ? "تيسير" : "محايد"
usedBias = newsBiasIn == "تلقائي" ? autoBias : newsBiasIn
pricedTag = pricedHawk ? "مسعّر هبوط" : pricedDove ? "مسعّر صعود" : already < 0.25 ? "غير مسعّر" : "جزئي"
expShow = (newsBiasIn == "تلقائي" ? "تلقائي: " + autoBias : newsBiasIn) + " | " + pricedTag

statN = timeframe.in_seconds() >= 900 ? 4 : 8
isMajorNewsBar = ((isNfpBar or isCpiBar or isPpiBar or isPceBar or isRetailBar or isGdpBar or isDurBar or isHouseBar or isPhillyBar or isTradeBar or isEmpBar or isProdBar or isImpBar) and w0830Bar) or (isFomcBar and (w1400Bar or w1430Bar)) or (isMinsBar and w1400Bar) or (isJh28Bar and w1000Bar) or ((isIsmBar or isIsmsBar or isJoltsBar or isMichBar or isConfBar or isNhsBar or isFactBar or isExistBar or isPendBar or isWholeBar) and w1000Bar) or (isDallasBar and w1030Bar) or (isIpBar and w0915Bar) or (isAdpBar and w0815Bar) or (isBeigeBar and w1400Bar) or ((isChiBar or isSpmBar or isFlashBar) and w0945Bar)
isClaimNewsBar = isThuBar and w0830Bar and not isNfpBar and not isCpiBar and not isPpiBar and not isPceBar
newsStart = isMajorNewsBar and not isMajorNewsBar[1]
claimStart = isClaimNewsBar and not isClaimNewsBar[1]
flowBull = emaUp and htfUp
flowBear = emaDn and not htfUp
var int qBar = na
var float qAtr = na
var int qTrend = 0
var float qPx = na
var float qHi = na
var float qLo = na
var bool qClaim = false
var string qName = ""
var float lastRet = na
var float lastEndPx = na
var float lastLo2 = na
var float lastHi2 = na
var string lastNm = ""
var array<float> evAbs = array.new_float()
var array<float> evAbsC = array.new_float()
var array<int> evWith = array.new_int()
if newsStart or claimStart
    qBar := bar_index
    qAtr := nz(atr, close * 0.01)
    qTrend := flowBull ? 1 : flowBear ? -1 : (close >= open ? 1 : -1)
    qPx := close
    qHi := high
    qLo := low
    qClaim := claimStart
    qName := isJh28Bar or isJh27Bar ? "جاكسون هول" : isFomcBar ? "FOMC" : isMinsBar ? "محضر FOMC" : isCpiBar ? "CPI" : isPpiBar ? "PPI" : isPceBar ? "PCE" : isNfpBar ? "NFP" : isRetailBar ? "تجزئة" : isGdpBar ? "GDP" : isIsmBar ? "ISM مصنع" : isIsmsBar ? "ISM خدمات" : isJoltsBar ? "JOLTS" : isAdpBar ? "ADP" : isMichBar ? "ميشيغان" : isConfBar ? "ثقة المستهلك" : isDurBar ? "سلع معمرة" : isHouseBar ? "إسكان" : isNhsBar ? "منازل جديدة" : isExistBar ? "منازل قائمة" : isPendBar ? "منازل معلقة" : isChiBar ? "شيكاغو PMI" : isSpmBar ? "PMI" : isFlashBar ? "PMI أولي" : isPhillyBar ? "فيلادلفيا" : isDallasBar ? "دالاس Fed" : isEmpBar ? "إمباير" : isFactBar ? "طلبات مصانع" : isTradeBar ? "تجارة" : isWholeBar ? "مخزون جملة" : isIpBar ? "إنتاج صناعي" : isProdBar ? "إنتاجية" : isImpBar ? "أسعار واردات" : isBeigeBar ? "Beige" : claimStart ? "Claims" : "خبر"
if not na(qBar) and bar_index > qBar and bar_index < qBar + statN
    qHi := math.max(qHi, high)
    qLo := math.min(qLo, low)
if not na(qBar) and bar_index - qBar == statN
    qHi := math.max(qHi, high)
    qLo := math.min(qLo, low)
    span = math.max(qHi - qPx, qPx - qLo)
    moveAtr = qAtr > 0 ? span / qAtr : 0.0
    ret = close - qPx
    withT = (ret > 0 and qTrend > 0) or (ret < 0 and qTrend < 0) ? 1 : 0
    if qClaim
        array.push(evAbsC, moveAtr)
        if array.size(evAbsC) > 12
            array.shift(evAbsC)
    else
        array.push(evAbs, moveAtr)
        array.push(evWith, withT)
        if array.size(evAbs) > 12
            array.shift(evAbs)
            array.shift(evWith)
    lastRet := close - qPx
    lastEndPx := close
    lastLo2 := qLo
    lastHi2 := qHi
    lastNm := qName
    qBar := na
nEv = array.size(evAbs)
nEvC = array.size(evAbsC)
avgAbs = nEv > 0 ? array.avg(evAbs) : na
avgAbsC = nEvC > 0 ? array.avg(evAbsC) : na
int nWith = 0
if nEv > 0
    for i = 0 to nEv - 1
        nWith += array.get(evWith, i)
pctWith = nEv > 0 ? 100.0 * nWith / nEv : na
useClaims = nearestTs == tsClaims
avgUse = useClaims ? (nEvC >= 3 ? avgAbsC : nz(avgAbs, 1.2) * 0.45) : avgAbs
nShow = useClaims ? nEvC : nEv
statTxt = nShow < 3 ? "لا يكفي تاريخ سعري" : str.tostring(close - (nShow >= 3 ? avgUse : 1.2) * nz(atr, close * 0.01), "#.##") + " – " + str.tostring(close + (nShow >= 3 ? avgUse : 1.2) * nz(atr, close * 0.01), "#.##") + (useClaims ? "" : pctWith >= 60 ? (emaUp ? " | غالباً صعود" : " | غالباً هبوط") : pctWith <= 40 ? (emaUp ? " | غالباً هبوط" : " | غالباً صعود") : " | اتجاه مختلط")
statCol = nShow < 3 ? color.gray : useClaims ? color.orange : pctWith >= 60 ? color.lime : pctWith <= 40 ? color.red : color.orange
expCol = usedBias == "تيسير" ? color.lime : usedBias == "تشديد" ? color.red : color.gray
atrAvg = ta.sma(atr, 20)
sq = atr < atrAvg * 0.82 ? 1.35 : atr > atrAvg * 1.25 ? 0.85 : 1.0
leftDn = pricedHawk ? 0.45 : 1.0
leftUp = pricedDove ? 0.45 : 1.0
band = (nShow >= 3 ? avgUse : (useClaims ? 0.55 : 1.2)) * nz(atr, close * 0.01) * sq
float pxLo = close - band
float pxHi = close + band
biasTxt = "محايد"
if usedBias == "تشديد"
    pxLo := close - band * 1.30 * leftDn
    pxHi := close + band * (pricedHawk ? 0.90 : 0.50)
    biasTxt := "هبوط"
else if usedBias == "تيسير"
    pxLo := close - band * (pricedDove ? 0.90 : 0.50)
    pxHi := close + band * 1.30 * leftUp
    biasTxt := "صعود"
else
    pxLo := close - band * (pricedHawk ? 0.55 : 1.0)
    pxHi := close + band * (pricedDove ? 0.55 : 1.0)
pxTxt = str.tostring(pxLo, "#.##") + " – " + str.tostring(pxHi, "#.##")
pxCol = biasTxt == "صعود" ? color.lime : biasTxt == "هبوط" ? color.red : color.orange
newsDirTxt = biasTxt
newsDirCol = pxCol
newsPricedTxt = pricedTag
liveOn = not na(qBar)
resRet = liveOn ? close - qPx : lastRet
resNow = liveOn ? close : lastEndPx
resLo = liveOn ? qLo : lastLo2
resHi = liveOn ? qHi : lastHi2
resNm = liveOn ? qName : lastNm
resPx0 = liveOn ? qPx : (na(lastEndPx) or na(lastRet) ? na : lastEndPx - lastRet)
resThr = nz(atr, close * 0.01) * 0.25
resPct = not na(resRet) and not na(resPx0) and resPx0 != 0 ? resRet / resPx0 * 100.0 : na
resPre = liveOn ? "الآن " : "آخر "
newsResTxt = na(resRet) ? "انتظار الخبر" : resRet > resThr ? resPre + resNm + " | صعد " + str.tostring(resNow, "#.##") + " (+" + str.tostring(resPct, "#.#") + ")" : resRet < -resThr ? resPre + resNm + " | نزل " + str.tostring(resNow, "#.##") + " (" + str.tostring(resPct, "#.#") + ")" : resPre + resNm + " | تذبذب " + str.tostring(resLo, "#.##") + "-" + str.tostring(resHi, "#.##")
newsResCol = na(resRet) ? color.gray : resRet > resThr ? color.lime : resRet < -resThr ? color.red : color.orange

var int lastFireTs = na
var int lastPostMin = 30
if isHighImpact and not isHighImpact[1]
    lastFireTs := timenow
    lastPostMin := (isFomcDay or isMinsDay or isBeigeDay or isJh27 or isJh28) ? 60 : 30
newsPre = nearestTs < FAR and nearestLeft <= 60
newsPost = not na(lastFireTs) and (timenow - lastFireTs) <= lastPostMin * 60000
newsPanel = newsPre or newsPost or isHighImpact

mxQtyUse = mxCont * mxContSz
mxOpen = mxEntry > 0 and mxCont > 0 and mxMargin > 0 and mxLev >= 1
mxLong = mxSide == "شراء"
mxMark = math.round(close * 100.0) / 100.0
mxPnl = mxOpen ? (mxLong ? (mxMark - mxEntry) : (mxEntry - mxMark)) * mxQtyUse : 0.0
mxMmr = mxMMR / 100.0
mxNotional = mxQtyUse * mxEntry
mxQtyBad = mxOpen and mxNotional > 0 and mxMargin > mxNotional
mxIMR = mxOpen and mxNotional > 0 ? math.min(mxMargin / mxNotional, 0.90) : 1.0 / mxLev
mxLiq = mxOpen and not mxQtyBad ? (mxLong ? mxEntry * (1.0 - mxIMR + mxMmr) : mxEntry * (1.0 + mxIMR - mxMmr)) : na
mxSideTxt = mxOpen ? ((mxLong ? "لونج " : "شورت ") + str.tostring(mxLev, "#") + "x · " + str.tostring(mxCont) + " Cont") : "لا صفقة"
mxPnlTxt = (mxPnl >= 0 ? "+" : "") + str.tostring(mxPnl, "#.##")
mxLiqTxt = mxOpen and not na(mxLiq) ? str.tostring(mxLiq, "#.##") : "—"
mxPnlCol = not mxOpen ? color.gray : mxQtyBad ? color.orange : mxPnl > 0 ? color.lime : mxPnl < 0 ? color.red : color.gray
mxSideCol = not mxOpen ? color.gray : mxQtyBad ? color.orange : mxLong ? color.lime : color.red
mxPnlLiqTxt = not mxOpen ? "—" : mxQtyBad ? "الكمية Cont غلط — Size(Cont) بدون فاصلة" : mxPnlTxt + " @" + str.tostring(mxMark, "#.##") + " | تصفية " + mxLiqTxt
newsNearTxt = nearestCD + " | " + newsStatus
newsDirRngTxt = newsDirTxt + "  " + pxTxt
newsMixTxt = newsPricedTxt + " | " + statTxt
sz = size.small

slHitsLiq = mxOpen and not na(slP) and not na(mxLiq) and (mxLong ? slP <= mxLiq : slP >= mxLiq)
if hasTrade and not na(slP)
    lvTxt := "وقف " + str.tostring(slP, "#.##") + " | هدف " + str.tostring(tpP, "#.##") + (mxOpen ? (slHitsLiq ? " | الوقف يصفّيك" : " | الوقف قبل التصفية") : "")
    if slHitsLiq
        lvCol := color.orange
lockNow = mxOpen and mxPnl > 0 and math.abs(mxMark - mxEntry) >= math.max(atrN * 0.45, mxEntry * 0.0035)
newsBlockEnter = nearestLeft <= 60 and nearestLeft > 0 and nearestTs < FAR
thinSess = sessName == "سيولة ضعيفة"
if not (failNow or unstLong or unstShort)
    if mxOpen and lockNow
        enterTxt := "اقفل نصف | حرّك الوقف فوق الدخول"
        enterCol := color.yellow
    else if newsBlockEnter and not mxOpen
        enterTxt := "لا تدخل — خبر خلال " + str.tostring(nearestLeft) + " د"
        enterCol := color.red
        enterNowBuy := false
        enterNowSell := false
    else if enterNowBuy and thinSess
        enterTxt := "لا تدخل — سيولة ضعيفة"
        enterCol := color.orange
        enterNowBuy := false
    else if enterNowSell and thinSess
        enterTxt := "لا تدخل — سيولة ضعيفة"
        enterCol := color.orange
        enterNowSell := false
    else if enterNowBuy and hardBlockBuy and not (sweepLoC or reclaimLo)
        enterTxt := "لا تدخل — الفريم الأكبر هابط"
        enterCol := color.orange
        enterNowBuy := false
    else if enterNowSell and hardBlockSell and not (sweepHiC or reclaimHi)
        enterTxt := "لا تدخل — الفريم الأكبر صاعد"
        enterCol := color.orange
        enterNowSell := false
    else if enterNowBuy and not btcUp
        enterTxt := enterTxt + " | بحذر BTC هابط"
    else if enterNowSell and btcUp
        enterTxt := enterTxt + " | بحذر BTC صاعد"
recShow := rec + " → " + enterTxt

var line lnHi = na
var line lnLo = na
var line lnMd = na
var box bx = na
if showBox and barstate.islast
    if not na(lnHi)
        line.delete(lnHi)
    if not na(lnLo)
        line.delete(lnLo)
    if not na(lnMd)
        line.delete(lnMd)
    if not na(bx)
        box.delete(bx)
    lnHi := line.new(bar_index - workLen, boxHi, bar_index + 3, boxHi, color=color.new(color.orange, 0), width=2, style=line.style_dashed)
    lnLo := line.new(bar_index - workLen, boxLo, bar_index + 3, boxLo, color=color.new(color.orange, 0), width=2, style=line.style_dashed)
    lnMd := line.new(bar_index - workLen, boxMid, bar_index + 3, boxMid, color=color.new(color.gray, 30), width=1, style=line.style_dotted)
    bx := box.new(bar_index - workLen, boxHi, bar_index + 3, boxLo, bgcolor=color.new(inRange or flagUp or flagDn ? color.orange : color.gray, 92), border_color=color.new(color.orange, 70), border_width=1)

plot(showBox ? slP : na, "وقف", color=color.red, style=plot.style_linebr, linewidth=1)
plot(showBox ? tpP : na, "هدف", color=color.lime, style=plot.style_linebr, linewidth=1)

bgcolor(isHighImpactBar ? color.new(color.orange, 90) : approachingBar ? color.new(color.yellow, 93) : na)

var table t = table.new(position.top_right, 2, 16, border_width=1)
if showTable and barstate.islast
    table.clear(t, 0, 0, 1, 15)
    table.cell(t, 0, 0, "MEXC Scalp v1.4", bgcolor=color.blue, text_color=color.white, text_size=sz)
    table.cell(t, 1, 0, "SOL", bgcolor=color.blue, text_color=color.yellow, text_size=sz)
    table.cell(t, 0, 1, "الدخول", bgcolor=color.new(enterCol, 20), text_size=sz)
    table.cell(t, 1, 1, recShow, bgcolor=color.new(enterCol, 20), text_color=color.white, text_size=sz)
    table.cell(t, 0, 2, "الحالة", bgcolor=color.gray, text_size=sz)
    table.cell(t, 1, 2, st + " | " + advice, text_color=stCol, text_size=sz)
    table.cell(t, 0, 3, "النطاق", bgcolor=color.gray, text_size=sz)
    table.cell(t, 1, 3, rngTxt, text_color=rngCol, text_size=sz)
    table.cell(t, 0, 4, "الاتجاه", bgcolor=color.gray, text_size=sz)
    table.cell(t, 1, 4, dirTxt, text_color=dirCol, text_size=sz)
    table.cell(t, 0, 5, "وقف / هدف", bgcolor=color.gray, text_size=sz)
    table.cell(t, 1, 5, lvTxt, text_color=lvCol, text_size=sz)
    table.cell(t, 0, 6, "صفقة MEXC", bgcolor=color.gray, text_size=sz)
    table.cell(t, 1, 6, mxSideTxt, text_color=mxSideCol, text_size=sz)
    table.cell(t, 0, 7, "الربح", bgcolor=color.gray, text_size=sz)
    table.cell(t, 1, 7, mxPnlLiqTxt, text_color=mxPnlCol, text_size=sz)
    table.cell(t, 0, 8, "الحجم", bgcolor=color.gray, text_size=sz)
    table.cell(t, 1, 8, rvolText, text_color=rvolCol, text_size=sz)
    table.cell(t, 0, 9, "تدفق كبير", bgcolor=color.gray, text_size=sz)
    table.cell(t, 1, 9, whaleTxt, text_color=whaleCol, text_size=sz)
    table.cell(t, 0, 10, "شمعات", bgcolor=color.gray, text_size=sz)
    table.cell(t, 1, 10, candleTxt, text_color=candleCol, text_size=sz)
    table.cell(t, 0, 11, "الجلسة", bgcolor=color.gray, text_size=sz)
    table.cell(t, 1, 11, sessTxt, text_color=sessCol, text_size=sz)
    table.cell(t, 0, 12, "أقرب خبر", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=sz)
    table.cell(t, 1, 12, newsNearTxt, bgcolor=color.new(#37474F, 0), text_color=newsCol, text_size=sz)
    if newsPanel
        table.cell(t, 0, 13, "اتجاه الخبر", bgcolor=color.gray, text_size=sz)
        table.cell(t, 1, 13, newsDirRngTxt, text_color=newsDirCol, text_size=sz)
        table.cell(t, 0, 14, "نتيجة الخبر", bgcolor=color.gray, text_size=sz)
        table.cell(t, 1, 14, newsResTxt, text_color=newsResCol, text_size=sz)
        table.cell(t, 0, 15, "تسعير SOL", bgcolor=color.gray, text_size=sz)
        table.cell(t, 1, 15, newsMixTxt, text_color=statCol, text_size=sz)

alertcondition(enterNowBuy and not enterNowBuy[1], "شراء", "سكالب شراء الآن")
alertcondition(enterNowSell and not enterNowSell[1], "بيع", "سكالب بيع الآن")
alertcondition(failNow and not failNow[1], "اخرج", "لم يستقر — اخرج فقط")
alertcondition(lockNow and not lockNow[1], "جني", "اقفل نصف وحرّك الوقف")
alertcondition(isHighImpact and not isHighImpact[1], "خبر", "نافذة أخبار")
